# Pantheon v2 — Optional Server Environment Variables
# Copy this file to .env for automatic key detection in local mode.
# You can also enter keys directly in the Pantheon UI Settings panel (stored locally in your browser).

# Choose at least one AI provider:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional dedicated search providers (Pantheon works out-of-the-box without these via DuckDuckGo + deep scraping):
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Local engine server port (default: 8787)
PANTHEON_PORT=8787
